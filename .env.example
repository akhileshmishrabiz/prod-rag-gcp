# GCP runtime template. Replace every angle-bracket value before deployment.
CONFIG_CONTRACT_VERSION=1.0.0
APP_MODE=gcp
AUTH_MODE=cloud_run_iam
DEV_TENANT_ID=<tenant-id>
GCS_DOCUMENT_BUCKET=<canonical-document-bucket>
TENANT_UPLOAD_PREFIX=tenants/<tenant-id>/uploads
FIXED_CORPUS=default
PUBSUB_WORKER_AUDIENCE=<worker-cloud-run-url>

GCP_PROJECT_ID=<gcp-project-id>
GCP_REGION=<gcp-region>
TF_STATE_PROJECT_ID=<terraform-state-project-id>
TF_STATE_BUCKET_NAME=<terraform-state-bucket>
TF_STATE_BUCKET_LOCATION=<terraform-state-region>
ARTIFACT_REGISTRY_REPOSITORY=<artifact-registry-repository>
DEV_OPERATOR_GROUP=<operator-group-email>
ALERT_EMAIL=<alert-email>
BUDGET_AMOUNT_USD=<monthly-budget>
VECTOR_SEARCH_SHARD_SIZE=SHARD_SIZE_SMALL
LOG_RETENTION_DAYS=30
SOURCE_REPOSITORY=<repository-url-or-N/A>

PIPELINE_VERSION=pipeline-1
PARSER_VERSION=parser-1
CHUNKER_VERSION=chunker-1
GENERATION_MODEL_ID=<pinned-ga-gemini-model>
EMBEDDING_MODEL_ID=<pinned-ga-embedding-model>
EMBEDDING_DIMENSIONS=<embedding-dimensions>

MAX_DOCUMENT_BYTES=10485760
MAX_DOCUMENT_CHUNKS=1000
MAX_EMBEDDING_BATCH_SIZE=100
MAX_QUERY_INPUT_CHARS=4000
MAX_QUERY_TOP_K=20
MAX_ACTIVE_GENERATIONS=1000
MAX_CANDIDATES_PER_DOCUMENT=5
MAX_CONTEXT_CHARS=40000
MAX_CONTEXT_TOKENS=8000
MAX_EVIDENCE_CHARS=6000
MAX_OUTPUT_TOKENS=1024
MAX_PDF_PAGES=200
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
DEPENDENCY_TIMEOUT_SECONDS=30
PROCESSING_DEADLINE_SECONDS=600
PROCESSING_LEASE_SECONDS=300
MAX_PROCESSING_ATTEMPTS=5
EMBEDDING_MAX_RETRIES=3
WORKER_CONCURRENCY=4
API_MAX_INSTANCES=2
WORKER_MAX_INSTANCES=2
