{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/config/runtime-config.v1.schema.json",
  "title": "RAG runtime configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "CONFIG_CONTRACT_VERSION",
    "APP_MODE",
    "AUTH_MODE",
    "DEV_TENANT_ID",
    "GCS_DOCUMENT_BUCKET",
    "TENANT_UPLOAD_PREFIX",
    "FIXED_CORPUS",
    "PUBSUB_WORKER_AUDIENCE",
    "PIPELINE_VERSION",
    "PARSER_VERSION",
    "CHUNKER_VERSION",
    "MAX_DOCUMENT_BYTES",
    "MAX_DOCUMENT_CHUNKS",
    "MAX_EMBEDDING_BATCH_SIZE",
    "MAX_QUERY_INPUT_CHARS",
    "MAX_QUERY_TOP_K",
    "MAX_ACTIVE_GENERATIONS",
    "MAX_CANDIDATES_PER_DOCUMENT",
    "MAX_CONTEXT_CHARS",
    "MAX_CONTEXT_TOKENS",
    "MAX_EVIDENCE_CHARS",
    "MAX_OUTPUT_TOKENS",
    "MAX_PDF_PAGES",
    "CHUNK_SIZE_TOKENS",
    "CHUNK_OVERLAP_TOKENS",
    "DEPENDENCY_TIMEOUT_SECONDS",
    "PROCESSING_DEADLINE_SECONDS",
    "PROCESSING_LEASE_SECONDS",
    "MAX_PROCESSING_ATTEMPTS",
    "EMBEDDING_MAX_RETRIES",
    "WORKER_CONCURRENCY",
    "API_MAX_INSTANCES",
    "WORKER_MAX_INSTANCES",
    "GENERATION_MODEL_ID",
    "EMBEDDING_MODEL_ID",
    "EMBEDDING_DIMENSIONS"
  ],
  "properties": {
    "CONFIG_CONTRACT_VERSION": { "const": "1.0.0" },
    "APP_MODE": { "enum": ["local", "gcp"] },
    "AUTH_MODE": { "enum": ["local_signed", "cloud_run_iam"] },
    "DEV_TENANT_ID": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "GCS_DOCUMENT_BUCKET": { "type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$" },
    "TENANT_UPLOAD_PREFIX": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "FIXED_CORPUS": { "const": "default" },
    "PUBSUB_WORKER_AUDIENCE": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 2048 },
    "LOCAL_AUTH_SIGNING_KEY_FILE": {
      "type": "string",
      "minLength": 1,
      "description": "Local-only path to a mounted development signing key; never an inline secret and never valid in gcp mode."
    },
    "GCP_PROJECT_ID": { "$ref": "#/$defs/cloudString" },
    "GCP_REGION": { "$ref": "#/$defs/cloudString" },
    "TF_STATE_PROJECT_ID": { "$ref": "#/$defs/cloudString" },
    "TF_STATE_BUCKET_NAME": { "$ref": "#/$defs/cloudString" },
    "TF_STATE_BUCKET_LOCATION": { "$ref": "#/$defs/cloudString" },
    "ARTIFACT_REGISTRY_REPOSITORY": { "$ref": "#/$defs/cloudString" },
    "DEV_OPERATOR_GROUP": { "$ref": "#/$defs/cloudString" },
    "ALERT_EMAIL": { "type": "string", "format": "email" },
    "BUDGET_AMOUNT_USD": { "type": "number", "exclusiveMinimum": 0 },
    "VECTOR_SEARCH_SHARD_SIZE": { "enum": ["SHARD_SIZE_SMALL", "SHARD_SIZE_MEDIUM", "SHARD_SIZE_LARGE"] },
    "LOG_RETENTION_DAYS": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "SOURCE_REPOSITORY": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "PIPELINE_VERSION": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "PARSER_VERSION": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "CHUNKER_VERSION": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "GENERATION_MODEL_ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Pinned immutable/GA model identifier in gcp mode; mutable aliases are forbidden."
    },
    "EMBEDDING_MODEL_ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Pinned immutable/GA model identifier in gcp mode; mutable aliases are forbidden."
    },
    "EMBEDDING_DIMENSIONS": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "MAX_DOCUMENT_BYTES": { "type": "integer", "minimum": 1, "maximum": 52428800 },
    "MAX_DOCUMENT_CHUNKS": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "MAX_EMBEDDING_BATCH_SIZE": { "type": "integer", "minimum": 1, "maximum": 250 },
    "MAX_QUERY_INPUT_CHARS": { "type": "integer", "minimum": 1, "maximum": 16000 },
    "MAX_QUERY_TOP_K": { "type": "integer", "minimum": 1, "maximum": 50 },
    "MAX_ACTIVE_GENERATIONS": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "MAX_CANDIDATES_PER_DOCUMENT": { "type": "integer", "minimum": 1, "maximum": 100 },
    "MAX_CONTEXT_CHARS": { "type": "integer", "minimum": 1, "maximum": 200000 },
    "MAX_CONTEXT_TOKENS": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "MAX_EVIDENCE_CHARS": { "type": "integer", "minimum": 1, "maximum": 200000 },
    "MAX_OUTPUT_TOKENS": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "MAX_PDF_PAGES": { "type": "integer", "minimum": 1, "maximum": 2000 },
    "CHUNK_SIZE_TOKENS": { "type": "integer", "minimum": 64, "maximum": 8192 },
    "CHUNK_OVERLAP_TOKENS": { "type": "integer", "minimum": 0, "maximum": 2048 },
    "DEPENDENCY_TIMEOUT_SECONDS": { "type": "number", "minimum": 0.1, "maximum": 300 },
    "PROCESSING_DEADLINE_SECONDS": { "type": "integer", "minimum": 10, "maximum": 3600 },
    "PROCESSING_LEASE_SECONDS": { "type": "integer", "minimum": 10, "maximum": 3600 },
    "MAX_PROCESSING_ATTEMPTS": { "type": "integer", "minimum": 1, "maximum": 20 },
    "EMBEDDING_MAX_RETRIES": { "type": "integer", "minimum": 0, "maximum": 10 },
    "WORKER_CONCURRENCY": { "type": "integer", "minimum": 1, "maximum": 100 },
    "API_MAX_INSTANCES": { "type": "integer", "minimum": 1, "maximum": 100 },
    "WORKER_MAX_INSTANCES": { "type": "integer", "minimum": 1, "maximum": 100 },
    "LOCAL_METADATA_ENDPOINT": { "$ref": "#/$defs/localEndpoint" },
    "LOCAL_GCS_ENDPOINT": { "$ref": "#/$defs/localEndpoint" },
    "LOCAL_PUBSUB_ENDPOINT": { "$ref": "#/$defs/localEndpoint" },
    "LOCAL_EMBEDDING_ENDPOINT": { "$ref": "#/$defs/localEndpoint" },
    "LOCAL_VECTOR_ENDPOINT": { "$ref": "#/$defs/localEndpoint" },
    "LOCAL_GENERATION_ENDPOINT": { "$ref": "#/$defs/localEndpoint" }
  },
  "$defs": {
    "cloudString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": { "pattern": "(PLACEHOLDER|placeholder|CHANGEME|changeme|TODO|todo|TBD|tbd)" }
    },
    "localEndpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": { "properties": { "APP_MODE": { "const": "local" } }, "required": ["APP_MODE"] },
      "then": {
        "properties": { "AUTH_MODE": { "const": "local_signed" } },
        "required": [
          "LOCAL_AUTH_SIGNING_KEY_FILE",
          "LOCAL_METADATA_ENDPOINT",
          "LOCAL_GCS_ENDPOINT",
          "LOCAL_PUBSUB_ENDPOINT",
          "LOCAL_EMBEDDING_ENDPOINT",
          "LOCAL_VECTOR_ENDPOINT",
          "LOCAL_GENERATION_ENDPOINT"
        ]
      }
    },
    {
      "if": { "properties": { "APP_MODE": { "const": "gcp" } }, "required": ["APP_MODE"] },
      "then": {
        "properties": {
          "AUTH_MODE": { "const": "cloud_run_iam" },
          "LOCAL_AUTH_SIGNING_KEY_FILE": false,
          "LOCAL_METADATA_ENDPOINT": false,
          "LOCAL_GCS_ENDPOINT": false,
          "LOCAL_PUBSUB_ENDPOINT": false,
          "LOCAL_EMBEDDING_ENDPOINT": false,
          "LOCAL_VECTOR_ENDPOINT": false,
          "LOCAL_GENERATION_ENDPOINT": false
        },
        "required": [
          "GCP_PROJECT_ID",
          "GCP_REGION",
          "TF_STATE_PROJECT_ID",
          "TF_STATE_BUCKET_NAME",
          "TF_STATE_BUCKET_LOCATION",
          "ARTIFACT_REGISTRY_REPOSITORY",
          "DEV_OPERATOR_GROUP",
          "ALERT_EMAIL",
          "BUDGET_AMOUNT_USD",
          "VECTOR_SEARCH_SHARD_SIZE",
          "LOG_RETENTION_DAYS",
          "SOURCE_REPOSITORY"
        ]
      }
    }
  ]
}
